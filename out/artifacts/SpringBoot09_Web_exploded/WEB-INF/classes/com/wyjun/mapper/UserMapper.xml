<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wyjun.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.wyjun.entity.User">
            <id property="id" column="id" />
            <result property="username" column="username" />
            <result property="password" column="password" />
            <result property="zipCode" column="zip_code" />
    </resultMap>

    <sql id="Base_Column_List">
        id,username,password,zip_code
    </sql>

    <select id="selectByPrimaryKey" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select
        <include refid="Base_Column_List" />
        from t_user
        where  id = #{id} 
    </select>

    <delete id="deleteByPrimaryKey" parameterType="java.lang.Long">
        delete from t_user
        where  id = #{id} 
    </delete>

    <insert id="insert" keyColumn="id" keyProperty="id" parameterType="com.wyjun.entity.User" useGeneratedKeys="true">
        insert into t_user
        ( id,username,password,zip_code)
        values (#{id},#{username},#{password},#{zipCode})
    </insert>

    <insert id="insertSelective" keyColumn="id" keyProperty="id" parameterType="com.wyjun.entity.User" useGeneratedKeys="true">
        insert into t_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
                <if test="id != null">id,</if>
                <if test="username != null">username,</if>
                <if test="password != null">password,</if>
                <if test="zipCode != null">zip_code,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
                <if test="id != null">#{id},</if>
                <if test="username != null">#{username},</if>
                <if test="password != null">#{password},</if>
                <if test="zipCode != null">#{zipCode},</if>
        </trim>
    </insert>

    <update id="updateByPrimaryKeySelective" parameterType="com.wyjun.entity.User">
        update t_user
        <set>
                <if test="username != null">
                    username = #{username},
                </if>
                <if test="password != null">
                    password = #{password},
                </if>
                <if test="zipCode != null">
                    zip_code = #{zipCode},
                </if>
        </set>
        where   id = #{id} 
    </update>

    <update id="updateByPrimaryKey" parameterType="com.wyjun.entity.User">
        update t_user
        set 
            username =  #{username},
            password =  #{password},
            zip_code =  #{zipCode}
        where   id = #{id} 
    </update>
</mapper>
