<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.wyjun.mapper.CarMapper">

    <select id="selectByCondition" resultType="com.wyjun.entity.Car">
        select *
        from t_car
        where brand like concat('%', #{brand}, '%')
          and guide_price > #{price}
    </select>
</mapper>
